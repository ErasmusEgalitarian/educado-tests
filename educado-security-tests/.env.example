
# API base usada pelo Playwright. Use loopback ou staging explicitamente autorizado.
# Nao use a URL de producao como valor padrao.
API_URL=http://127.0.0.1:5011

# JWTs de contas sinteticas/descartaveis; nunca cole tokens reais neste arquivo.
# Deixe vazio ate obter tokens do ambiente local ou staging autorizado.
CREATOR_TOKEN=
# Token de um segundo criador, dono da atividade usada no caso AT-09-N2.
OTHER_CREATOR_TOKEN=
ADMIN_TOKEN=
STUDENT_A_TOKEN=
STUDENT_B_TOKEN=

# Recursos sinteticos existentes e com precondicoes verificadas.
# CREATOR_COURSE_ID: curso ativo usado pelo teste AT-23; para testar P10, precisa ter atividades.
CREATOR_COURSE_ID=
# Curso existente cujo proprietario e diferente de CREATOR_TOKEN (AT-06).
OTHER_CREATOR_COURSE_ID=
# Secao e atividade existentes para os cenarios de leitura anonima AT-10.
SECTION_ID=
ACTIVITY_ID=
# Secao e atividade existentes de outro criador, para controles horizontais futuros.
OTHER_CREATOR_SECTION_ID=
OTHER_CREATOR_ACTIVITY_ID=
# Midia existente de outro criador para teste de metadados (AT-17).
MEDIA_ID=
# IDs existentes com objetos armazenados; stream depende das politicas P07 e do storage.
PUBLIC_MEDIA_ID=
PRIVATE_MEDIA_ID=
# Matrículas/recursos existentes dos estudantes sinteticos A e B.
STUDENT_A_COURSE_ID=
STUDENT_B_COURSE_ID=
# Certificado existente de B; o PDF requer objeto S3/MinIO.
STUDENT_B_CERTIFICATE_ID=
# Codigo valido de certificado sintetico; use somente depois de aprovada a politica P08.
CERTIFICATE_CODE=

# Dupla opt-in para testes que alteram dados.
# Ambos devem continuar false por padrao; habilite somente em staging autorizado,
# com fixtures descartaveis, snapshots e restauracao implementados.
# Cada teste de escrita deve chamar canRunMutation() antes de enviar a requisicao.
RUN_MUTATION_TESTS=false
ALLOW_MUTATIONS=false
